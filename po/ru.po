#~ msgid ""
#~ "\n"
#~ "\n"
#~ "epm create-fake - create package with fake provides and requires. Use "
#~ "follow params:\n"
#~ "    --install                - auto install fake package\n"
#~ "    --version=*              - set package version (by default version is "
#~ "0)\n"
#~ "    --release=*              - set package release (by default release is "
#~ "0)\n"
#~ "    --requires=*             - set package requires\n"
#~ "    --provides=*             - set package provides (by default package "
#~ "provide only it self)\n"
#~ "\n"
#~ "Examples:\n"
#~ "    # epm create-fake --install python-somepackage\n"
#~ "    # epm create-fake --install --provides=\"python3dist(somepackage)\" "
#~ "python-somepackage\n"
#~ "    # epm create-fake --install --requires=python3 --requires=python3-"
#~ "module python-somepackage\n"
#~ "\n"
#~ msgstr ""
#~ "\n"
#~ "\n"
#~ "epm create-fake - создание пакета с фиктивными provides и requires. "
#~ "Параметры:\n"
#~ "    --install                - автоматическая установка фиктивного "
#~ "пакета\n"
#~ "    --version=*              - задать версию пакета (по умолчанию 0)\n"
#~ "    --release=*              - задать релиз пакета (по умолчанию 0)\n"
#~ "    --requires=*             - задать требования пакета\n"
#~ "    --provides=*             - задать предоставляемое пакетом (по "
#~ "умолчанию пакет предоставляет только себя)\n"
#~ "\n"
#~ "Примеры:\n"
#~ "    # epm create-fake --install python-somepackage\n"
#~ "    # epm create-fake --install --provides=\"python3dist(somepackage)\" "
#~ "python-somepackage\n"
#~ "    # epm create-fake --install --requires=python3 --requires=python3-"
#~ "module python-somepackage\n"
#~ "\n"

#~ msgid ""
#~ "\n"
#~ "\n"
#~ "epm status - check status of the package and return result via exit code\n"
#~ "Usage: epm status [options] <package> [version]\n"
#~ "\n"
#~ "Options:\n"
#~ "  --installed [version] check if <package> is installed (if version is "
#~ "specified, not older than the version)\n"
#~ "  --installable         check if <package> can be installed from the "
#~ "repo\n"
#~ "  --original            check if <package> is from distro repo\n"
#~ "  --certified           check if <package> is certified that it can be "
#~ "installed without repacking\n"
#~ "  --thirdparty          check if <package> from a third-party source "
#~ "(didn't packed for this distro)\n"
#~ "  --repacked            check if <package> was repacked with epm repack\n"
#~ "  --validate            check if <package> is accessible (we can get a "
#~ "fields from it)\n"
#~ "  --supported           check if distribution is supported by epm status\n"
#~ msgstr ""
#~ "\n"
#~ "\n"
#~ "epm status - проверка состояния пакета и возврат результата через код "
#~ "выхода\n"
#~ "Использование: epm status [параметры] <пакет> [версия]\n"
#~ "\n"
#~ "Параметры:\n"
#~ "  --installed [версия] проверить, установлен ли <пакет> (если указана "
#~ "версия, то не старше этой версии)\n"
#~ "  --installable         проверить, можно ли установить <пакет> из "
#~ "репозитория\n"
#~ "  --original            проверить, принадлежит ли <пакет> репозиторию "
#~ "дистрибутива\n"
#~ "  --certified           проверить, сертифицирован ли <пакет> для "
#~ "установки без перепаковки\n"
#~ "  --thirdparty          проверить, является ли <пакет> сторонним "
#~ "источником (не упакован для этого дистрибутива)\n"
#~ "  --repacked            проверить, был ли <пакет> перепакован с помощью "
#~ "epm repack\n"
#~ "  --validate            проверить, доступен ли <пакет> (можно ли получить "
#~ "из него поля)\n"
#~ "  --supported           проверить, поддерживается ли дистрибутив командой "
#~ "epm status\n"

#~ msgid ""
#~ "\n"
#~ "epm info - print package information\n"
#~ "Usage: epm info [options] <package>\n"
#~ "\n"
#~ "Options:\n"
#~ "  -h, --help        show this help\n"
#~ "  --requires        print package requires (dependencies)\n"
#~ "  --provides        print package provides\n"
#~ "  --conflicts       print package conflicts\n"
#~ "  --obsoletes       print packages obsoleted by this package\n"
#~ "  --recommends      print recommended packages\n"
#~ "  --suggests        print suggested packages\n"
#~ "  --changelog       print package changelog\n"
#~ "  --whatdepends     print packages that depend on this\n"
#~ "  --whatprovides    print packages that provide the target\n"
#~ "\n"
#~ "Without options prints general package information.\n"
#~ msgstr ""
#~ "\n"
#~ "epm info - вывод информации о пакете\n"
#~ "Использование: epm info [параметры] <пакет>\n"
#~ "\n"
#~ "Параметры:\n"
#~ "  -h, --help        показать эту справку\n"
#~ "  --requires        показать зависимости пакета\n"
#~ "  --provides        показать что предоставляет пакет\n"
#~ "  --conflicts       показать конфликты пакета\n"
#~ "  --obsoletes       показать пакеты, вытесняемые этим\n"
#~ "  --recommends      показать рекомендуемые пакеты\n"
#~ "  --suggests        показать предлагаемые пакеты\n"
#~ "  --changelog       показать журнал изменений пакета\n"
#~ "  --whatdepends     показать пакеты, зависящие от этого\n"
#~ "  --whatprovides    показать пакеты, предоставляющие цель\n"
#~ "\n"
#~ "Без параметров выводит общую информацию о пакете.\n"

