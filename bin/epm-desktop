load_helper epm-query
load_helper epm-desktop-manager


# args: de [options]
run_script()
{
    local script="$CONFIGDIR/desktop.d/$1.sh"
    [ -s "$script" ] || return
    [ -f "$script.rpmnew" ] && warning 'There is .rpmnew file(s) in $psdir dir. The desktop script can be outdated.'

    shift
    [ "$PROGDIR" = "/usr/bin" ] && SCPATH="$PATH" || SCPATH="$PROGDIR:$PATH"
    ( unset EPMCURDIR ; export PATH=$SCPATH ; $script "$@" ) || warning "Postinstall/postuninstall script for $de_name encountered an issue."
    return
}

# args: de
get_json()
{
    local de_name="$1"
    realpath $CONFIGDIR/desktop.d/$de_name.json
}

# args: de
check_if_de_exists()
{
    local de_name="$1"

    [ -n "$de_name" ] || fatal "Missed DE name."

    local json="$(get_json $de_name)"

    [ -s "$json" ] && return

    fatal 'Error: Manifest for $de_name is not found.'
}


# args: de key
get_value()
{
    local de_name="$1"
    local key="$2"

    get_json_value "$(get_json $de_name)" "$key"
}


# args: de key
get_values()
{
    local de_name="$1"
    local key="$2"

    get_json_values "$(get_json $de_name)" "$key" | xargs
}


# arg: pkgname
__get_api_url()
{
    local package_name="$1"
    local branch="$(echo "$DISTRVERSION" | tr '[:upper:]' '[:lower:]')"
    echo "https://rdb.altlinux.org/api/package/package_info?name=$package_name&arch=$DISTRARCH&source=false&branch=$branch&full=false"
}

# de
get_main_package()
{
    local de_name="$1"
    # check by the first package in the dependencies list
    local package="$(get_values "$de_name" "dependencies" | cut -d' ' -f1)"
    [ -n "$package" ] || fatal 'Cannot get package name for $de_name'
    echo "$package"
}

get_repo_version()
{
    local de_name=$1

    local package=$(get_main_package "$de_name")

    local latest_version="$(get_json_value "$(__get_api_url $package)" '["packages",0,"version"]')"

    if [ -n "$latest_version" ] ; then
        echo "$latest_version"
        return
    fi

    warning '$package package is missed in the repo, use version from the local metadata'

    epm print version for package "$package" 2>/dev/null && return

    # fallback
    get_value "$de_name" "version"
}


# args: de
is_de_installed()
{
    local de_name="$1"

    is_installed $(get_main_package $de_name)
}


# args: de_name
get_available_variants()
{
    local de_name="$1"
    parse_json_object_keys metapackage_variants < "$(get_json $de_name)" | xargs
}

# args: de_name [variant]
install_de_meta()
{
    local de_name="$1"
    local variant="$2"
    local metapackages

    if [ -n "$variant" ] ; then
        # get metapackage from metapackage_variants using JSON path
        metapackages="$(get_json_value "$(get_json $de_name)" '["metapackage_variants","'$variant'"]')"
        if [ -z "$metapackages" ] ; then
            local available="$(get_available_variants "$de_name")"
            if [ -z "$available" ] ; then
                fatal "$de_name does not support variants"
            else
                fatal "Unknown variant '$variant' for $de_name. Available variants: $available"
            fi
        fi
    else
        metapackages="$(get_values "$de_name" "metapackages")"
    fi

    # silent skip missed metapackages
    [ -n "$metapackages" ] || return 0

    # we really want mark all installed packages as manually installed?
    docmd epm install --manual-requires $metapackages
}


# args: de_name [variant]
install_de()
{
    local de_name="$1"
    local variant="$2"

    if [ -z "$force" ] && is_de_installed $de_name ; then
        message "$de_name is already installed."
        return 1
    fi

    local dependencies="$(get_values "$de_name" "dependencies")"

    if [ -n "$variant" ] ; then
        message "Installing $de_name ($variant) with dependencies: $dependencies"
    else
        message "Installing $de_name with dependencies: $dependencies"
    fi

    if ! install_de_meta "$de_name" "$variant" ; then
        fatal "Failed to install metapackage(s) for $de_name."
    fi

    if ! docmd epm install $dependencies ; then
        fatal "Failed to install $de_name."
    fi

    run_script "$de_name-postin" $de_name
    message "$de_name successfully installed."

    # install a preferred display manager if none is installed yet
    local preferred_dm="$(get_values "$de_name" "preferred_dm")"
    if [ -n "$preferred_dm" ] ; then
        ensure_dm $preferred_dm
    fi

}


remove_de()
{
    local de_name="$1"

    if [ -z "$force" ] && ! is_de_installed "$de_name" ; then
        message "$de_name is not installed."
        return 0
    fi

    local dependencies="$(get_values "$de_name" "dependencies")"

    message "Removing $de_name with dependencies: $dependencies"

    # We hope that metapackages will removed by dependency
    if ! docmd epm remove $dependencies ; then
        fatal "Failed to remove $de_name."
    fi

    run_script "$de_name-postun" $de_name
    message "$de_name successfully removed."
}


get_de_info()
{
    local de_name="$1"
    local json_flag="$2"

    info "Trying get info from remote ALT DB ..."
    version="$(get_repo_version $de_name)"
    installed="$(is_de_installed $de_name && echo 'true' || echo 'false')"

    if [ -n "$json_flag" ]; then
        local json="$(get_json $de_name)"

        cat "$json" | sed -E 's/"version":.*"/"version": "'$version'"/g' | sed 's/"installed":.*/"installed": '$installed'/g'
        return
    fi

    local variants="$(get_available_variants "$de_name")"
    message "Information for $de_name:
    Name: $(get_value $de_name name)
    Version: $version
    Installed: $installed
    Description: $(get_value $de_name description)"
    [ -n "$variants" ] && message "    Variants: $variants"
}


list_des()
{
    local json_flag="$1"
    if [ -z "$json_flag" ]; then
        for de in $CONFIGDIR/desktop.d/*.json ; do
            basename "$de" .json || fatal
        done
        return
    fi

    echo '['
    local first=1
    for de in $CONFIGDIR/desktop.d/*.json ; do
        if [ $first = 1 ] ; then
            first=0
        else
            echo ','
        fi

        de_name="$(basename $de .json)" || fatal
        get_de_info "$de_name" "$json_flag"

    done
    echo ']'
}


list_installed_des()
{
    local de de_name
    for de in $CONFIGDIR/desktop.d/*.json ; do
        de_name="$(basename "$de" .json)" || fatal
        is_de_installed "$de_name" && echo "$de_name"
    done
}

epm_desktop_help()
{
    message 'Usage: epm desktop <command> [--json] [option]'
            get_help HELPCMD $SHAREDIR/epm-desktop
    message '
Examples:
  epm desktop install kde
  epm desktop install kde=small
  epm desktop manager install lightdm
'
}


epm_desktop()
{

    local cmd="$1"
    shift

    local json_flag=''

    case "$1" in
        --json)
            json_flag=1
            shift
            ;;
    esac

    case "$cmd" in
        "-h"|"--help"|"help")         # HELPCMD: help
            epm_desktop_help
            return
            ;;
        install)                      # HELPCMD: <de_name>[=variant]   Install a desktop environment
            local de_arg="$1"
            local de_name="${de_arg%%=*}"
            local variant=""
            # parse de=variant
            if [ "$de_arg" != "$de_name" ] ; then
                variant="${de_arg#*=}"
            fi
            check_if_de_exists "$de_name"
            install_de "$de_name" "$variant"
            ;;
        remove)                       # HELPCMD: <de_name>   Remove a desktop environment
            check_if_de_exists "$1"
            remove_de "$1"
            ;;
        info)                         # HELPCMD: <de_name>   Get information about a desktop environment
            check_if_de_exists "$1"
            get_de_info "$1" $json_flag
            ;;
        list)                         # HELPCMD:             List all available desktop environments
            list_des $json_flag
            ;;
        list-installed)               # HELPCMD:             List installed desktop environments
            list_installed_des
            ;;
        manager)                      # HELPCMD: <command>   Manage display managers (install, remove, list, ...)
            epm_desktop_manager "$@"
            ;;
        installed)
            is_de_installed "$1"
            ;;
        version)
            get_repo_version "$1"
            ;;
        *)
            fatal 'Unknown option $cmd. Run with --help to get help'
            ;;
    esac
}
