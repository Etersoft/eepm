load_helper epm-sh-warmup
load_helper epm-sh-available

# Use pkglist-query on ALT Linux (much faster than apt-cache)
# Returns: TSV format: package<tab>version<tab>description
__alt_list_available_pkglist_query()
{
    local pkglists
    pkglists=$(ls /var/lib/apt/lists/*pkglist.* 2>/dev/null | grep -v debuginfo)
    [ -z "$pkglists" ] && return 1

    showcmd "pkglist-query ..."
    pkglist-query '%{NAME}\t%{VERSION}\t%{SUMMARY}\n' $pkglists
}

# Format TSV input to requested output format
# Input: package<tab>version<tab>description
# Uses: $short - output only package names
# Uses: $tsv - output as TSV (pass through)
__epm_format_available()
{
    if [ -n "$short" ] ; then
        cut -f1
    elif [ -n "$tsv" ] ; then
        cat
    else
        # human-readable: package=version - description
        awk -F'\t' '{
            if ($2) printf "%s=%s", $1, $2; else printf "%s", $1
            if ($3) printf " - %s", $3
            printf "\n"
        }'
    fi
}


# Suggest similar packages using fzf fuzzy search
# Args: package_name
# Returns: selected package name (if interactive) or empty
__epm_suggest_similar_packages()
{
    local pkg="$1"
    local count="${suggest_count:-7}"

    # need fzf for fuzzy search
    is_command fzf || return 1

    local similar
    similar="$(epm_list_available | fzf -f "$pkg" 2>/dev/null | head -$count)"
    [ -z "$similar" ] && return 1

    # Interactive selection if enabled (via config or --interactive flag)
    if [ -n "$suggest_interactive$interactive" ] && inputisatty ; then
        local selected
        selected="$(echo "$similar" | fzf --prompt="$(eval_gettext "Select package"): " --height=10 --reverse)"
        if [ -n "$selected" ] ; then
            # extract package name (before = or space)
            echo "$selected" | sed -e 's/[= ].*//'
            return 0
        fi
        return 1
    fi

    # Non-interactive: just show suggestions (to stderr)
    echo "" >&2
    echog "Perhaps you meant:" >&2
    echo "$similar" | sed 's/^/  /' >&2
    return 1
}

# Suggest similar packages for a list of packages
# Args: package_names...
# Returns: selected packages (if interactive) or empty
__epm_suggest_similar_packages_by_list()
{
    local pkg
    local selected_all=""
    for pkg in "$@" ; do
        local selected
        selected="$(__epm_suggest_similar_packages "$pkg")"
        [ -n "$selected" ] && selected_all="$selected_all $selected"
    done
    echo $selected_all
}

__aptcyg_print_full()
{
    #showcmd apt-cyg show
    local VERSION=$(a= apt-cyg show "$1" | grep -m1 "^version: " | sed -e "s|^version: ||g")
    echo "$1-$VERSION"
}

__fo_pfn()
{
    grep -v "^$" | grep -- "$pkg_filenames"
}

# Internal function to get available packages in TSV format
# Returns: TSV format where supported, native format otherwise
__epm_list_available_internal()
{
    local CMD

    case $PMTYPE in
        apt-dpkg)
            warmup_dpkgbase
            ;;
        apt-rpm)
            warmup_rpmbase
            ;;
    esac

    case $PMTYPE in
        apt-rpm)
            # use pkglist-query if available (much faster, returns TSV)
            if is_command pkglist-query ; then
                __alt_list_available_pkglist_query
                return
            fi
            docmd apt-cache search .
            ;;
        apt-dpkg)
            docmd apt-cache search .
            ;;
        apm-rpm)
            # TODO: --format json?
            CMD="apm system list --limit 100000"
            ;;
        dnf-*)
            warmup_rpmbase
            docmd dnf list --available
            ;;
        yum-*)
            warmup_rpmbase
            docmd yum list available
            ;;
        packagekit)
            # see for filter list: pkcon get-filters
            docmd pkcon get-packages -p | sed -e "s| (.*||g" -e "s|.* ||"
            ;;
        snappy)
            docmd snappy find .
            ;;
        snap)
            docmd snap find .
            ;;
        pacman)
            docmd pacman -Sl
            ;;
        appget)
            docmd appget search .
            ;;
        winget)
            docmd winget search .
            ;;
        emerge)
            docmd eix --world
            ;;
        termux-pkg)
            docmd pkg list-all
            ;;
        npackd)
            CMD="npackdcl list"
            ;;
        eopkg)
            CMD="eopkg list-available"
            ;;
        stplr)
            CMD="stplr list"
            ;;
        pisi)
            CMD="pisi list-available"
            ;;
        choco)
            CMD="choco search ."
            ;;
        slackpkg)
            CMD="slackpkg search ."
            ;;
        homebrew)
            docmd brew search .
            ;;
        opkg)
            CMD="opkg list-available"
            ;;
        apk)
            CMD="apk list --available"
            ;;
        nix)
            CMD="nix-env -qaP"
            ;;
        xbps)
            CMD="xbps-query -l -R"
            showcmd $CMD
            $CMD | sed -e "s|^ii ||g" -e "s| .*||g" | __fo_pfn
            return
            ;;
        *)
            fatal 'Have no suitable query command for $PMTYPE'
            ;;
    esac

    if [ -n "$CMD" ] ; then
        docmd $CMD | __fo_pfn
    fi
}

epm_list_available()
{
    if [ -n "$1" ] ; then
        # list --available with args is the same as search
        load_helper epm-search
        epm_search "$@"
        return
    fi

    # use cache by default (--direct bypasses cache)
    if [ -z "$direct" ] ; then
        if __epm_available_cache_exists ; then
            __epm_available_read_cache | __epm_format_available
            return
        fi
        warning "No package cache. Run 'epm update' to create it."
    fi

    # get fresh data and format
    __epm_list_available_internal | __epm_format_available
}
