load_helper epm-sh-warmup
load_helper epm-sh-available
load_helper epm-sh-search

# Use pkglist-query on ALT Linux (much faster than apt-cache)
# Returns: TSV format: package<tab>version<tab>description
__alt_list_available_pkglist_query()
{
    local pkglists
    pkglists=$(ls /var/lib/apt/lists/*pkglist.* 2>/dev/null | grep -v debuginfo)
    [ -z "$pkglists" ] && return 1

    showcmd "pkglist-query ..."
    pkglist-query '%{NAME}\t%{VERSION}\t%{SUMMARY}\n' $pkglists
}

# Convert apt-cache search output to TSV
# Input: package - description
# Output: package<tab><tab>description (no version available)
__epm_convert_apt_to_tsv()
{
    sed 's/ - /\t\t/'
}


# Convert pacman -Ss output to TSV
# Input: two-line format:
#   repo/package version [status]
#       description
# Output: package<tab>version<tab>description
__epm_convert_pacman_to_tsv()
{
    awk '
    /^[a-z]/ {
        # repo/package version line
        split($1, a, "/")
        pkg = a[2]
        ver = $2
    }
    /^    / {
        # description line (4 spaces indent)
        desc = $0
        gsub(/^    /, "", desc)
        print pkg "\t" ver "\t" desc
    }'
}

# Convert apk list output to TSV
# Input: package-version {repo} (arch) [status] or package-version description
# Output: package<tab>version<tab>description
__epm_convert_apk_to_tsv()
{
    awk '{
        # package-version {repo}
        split($1, a, "-")
        pkg = a[1]
        ver = a[2]
        for (i=3; i<=length(a); i++) ver = ver "-" a[i]
        # description is after arch in ()
        desc = ""
        for (i=4; i<=NF; i++) desc = desc " " $i
        gsub(/^ /, "", desc)
        print pkg "\t" ver "\t" desc
    }'
}

# Convert opkg list output to TSV
# Input: package - version - description
# Output: package<tab>version<tab>description
__epm_convert_opkg_to_tsv()
{
    awk -F' - ' '{ print $1 "\t" $2 "\t" $3 }'
}

# Convert snap find output to TSV
# Input: Name Version Publisher Notes Summary (header line, then data)
# Output: package<tab>version<tab>description
__epm_convert_snap_to_tsv()
{
    tail -n +2 | awk '{
        pkg = $1
        ver = $2
        desc = ""
        for (i=5; i<=NF; i++) desc = desc " " $i
        gsub(/^ /, "", desc)
        print pkg "\t" ver "\t" desc
    }'
}

# Convert nix-env -qaP output to TSV
# Input: attribute package-version description...
# Output: package<tab>version<tab>description
__epm_convert_nix_to_tsv()
{
    awk '{
        # $1 is attribute path, $2 is package-version
        n = split($2, a, "-")
        pkg = a[1]
        for (i=2; i<n; i++) pkg = pkg "-" a[i]
        ver = a[n]
        desc = ""
        for (i=3; i<=NF; i++) desc = desc " " $i
        gsub(/^ /, "", desc)
        print pkg "\t" ver "\t" desc
    }'
}

# Convert eopkg list-available output to TSV
# Input: package - description, version
# Output: package<tab>version<tab>description
__epm_convert_eopkg_to_tsv()
{
    awk -F' - ' '{
        pkg = $1
        rest = $2
        # version is after last comma
        n = split(rest, a, ", ")
        ver = a[n]
        desc = a[1]
        for (i=2; i<n; i++) desc = desc ", " a[i]
        print pkg "\t" ver "\t" desc
    }'
}

# Convert xbps-query -Rs output to TSV
# Input: [*] package-version description
# Output: package<tab>version<tab>description
__epm_convert_xbps_to_tsv()
{
    awk '{
        # skip [*] or [-] prefix
        idx = 1
        if ($1 ~ /^\[/) idx = 2
        # package-version
        n = split($idx, a, "-")
        pkg = a[1]
        for (i=2; i<n; i++) pkg = pkg "-" a[i]
        ver = a[n]
        desc = ""
        for (i=idx+1; i<=NF; i++) desc = desc " " $i
        gsub(/^ /, "", desc)
        print pkg "\t" ver "\t" desc
    }'
}

# Convert choco search output to TSV
# Input: package version [Approved]
# Output: package<tab>version<tab>
__epm_convert_choco_to_tsv()
{
    grep -v "^Chocolatey" | awk '{ print $1 "\t" $2 "\t" }'
}

# Convert brew search output to TSV (names only)
# Input: package
# Output: package<tab><tab>
__epm_convert_brew_to_tsv()
{
    awk '{ print $1 "\t\t" }'
}

# Convert termux pkg list-all output to TSV
# Input: package/repo version arch [status]
# Output: package<tab>version<tab>
__epm_convert_termux_to_tsv()
{
    awk -F'/' '{
        pkg = $1
        split($2, a, " ")
        ver = a[1]
        print pkg "\t" ver "\t"
    }'
}



# Suggest similar packages using fzf fuzzy search
# Args: package_name
# Returns: selected package name (if interactive) or empty
__epm_suggest_similar_packages()
{
    local pkg="$1"
    local count="${suggest_count:-7}"

    # need fzf for fuzzy search
    is_command fzf || return 1

    local similar
    similar="$(epm_list_available | fzf -f "$pkg" 2>/dev/null | head -$count)"
    [ -z "$similar" ] && return 1

    # Interactive selection if enabled (via config or --interactive flag)
    if [ -n "$suggest_interactive$interactive" ] && inputisatty ; then
        local selected
        selected="$(echo "$similar" | fzf --prompt="$(eval_gettext "Select package"): " --height=10 --reverse)"
        if [ -n "$selected" ] ; then
            # extract package name (before = or space)
            echo "$selected" | sed -e 's/[= ].*//'
            return 0
        fi
        return 1
    fi

    # Non-interactive: just show suggestions (to stderr)
    echo "" >&2
    echog "Perhaps you meant:" >&2
    echo "$similar" | sed 's/^/  /' >&2
    return 1
}

# Suggest similar packages for a list of packages
# Args: package_names...
# Returns: selected packages (if interactive) or empty
__epm_suggest_similar_packages_by_list()
{
    local pkg
    local selected_all=""
    for pkg in "$@" ; do
        local selected
        selected="$(__epm_suggest_similar_packages "$pkg")"
        [ -n "$selected" ] && selected_all="$selected_all $selected"
    done
    echo $selected_all
}

__aptcyg_print_full()
{
    #showcmd apt-cyg show
    local VERSION=$(a= apt-cyg show "$1" | grep -m1 "^version: " | sed -e "s|^version: ||g")
    echo "$1-$VERSION"
}

# Get available packages in TSV format
# Returns: TSV format: package<tab>version<tab>description
__epm_list_available_tsv()
{
    local CMD

    case $PMTYPE in
        apt-dpkg)
            warmup_dpkgbase
            ;;
        apt-rpm|dnf-*|dnf5-*|yum-*)
            warmup_rpmbase
            ;;
    esac

    case $PMTYPE in
        apt-rpm)
            # use pkglist-query if available (much faster, native TSV)
            if is_command pkglist-query ; then
                __alt_list_available_pkglist_query
                return
            fi
            apt-cache search . | __epm_convert_apt_to_tsv
            ;;
        apt-dpkg)
            apt-cache search . | __epm_convert_apt_to_tsv
            ;;
        dnf-*|dnf5-*)
            # use repoquery to get name, version-release and summary in TSV format
            # note: format string uses literal tabs and newline, not escape sequences
            docmd dnf repoquery --available --qf '%{name}	%{version}-%{release}	%{summary}
'
            ;;
        yum-*)
            docmd yum repoquery --available --qf '%{name}	%{version}-%{release}	%{summary}
'
            ;;
        pacman)
            # use -Ss '' to get descriptions (two-line format)
            docmd pacman -Ss '' | __epm_convert_pacman_to_tsv
            ;;
        snap)
            docmd snap find . | __epm_convert_snap_to_tsv
            ;;
        apk)
            docmd apk list --available | __epm_convert_apk_to_tsv
            ;;
        opkg)
            docmd opkg list-available | __epm_convert_opkg_to_tsv
            ;;
        eopkg)
            docmd eopkg list-available | __epm_convert_eopkg_to_tsv
            ;;
        nix)
            docmd nix-env -qaP | __epm_convert_nix_to_tsv
            ;;
        xbps)
            docmd xbps-query -Rs '*' | __epm_convert_xbps_to_tsv
            ;;
        choco)
            docmd choco search . | __epm_convert_choco_to_tsv
            ;;
        homebrew)
            docmd brew search . | __epm_convert_brew_to_tsv
            ;;
        termux-pkg)
            docmd pkg list-all | __epm_convert_termux_to_tsv
            ;;
        # TODO: need format investigation
        apm-rpm)
            CMD="apm system list --limit 100000"
            ;;
        packagekit)
            docmd pkcon get-packages -p | sed -e "s| (.*||g" -e "s|.* ||"
            ;;
        snappy)
            docmd snappy find .
            ;;
        appget)
            docmd appget search .
            ;;
        winget)
            docmd winget search .
            ;;
        emerge)
            docmd eix --world
            ;;
        npackd)
            CMD="npackdcl list"
            ;;
        stplr)
            CMD="stplr list"
            ;;
        pisi)
            CMD="pisi list-available"
            ;;
        slackpkg)
            CMD="slackpkg search ."
            ;;
        *)
            fatal 'Have no suitable query command for $PMTYPE'
            ;;
    esac

    [ -n "$CMD" ] && docmd $CMD
}

epm_list_available()
{
    if [ -n "$1" ] ; then
        # list --available with args is the same as search
        load_helper epm-search
        epm_search "$@"
        return
    fi

    # use cache by default (--direct bypasses cache)
    if [ -z "$direct" ] ; then
        if __epm_available_cache_exists ; then
            __epm_available_read_cache | __epm_format_output | __epm_colorize_search_output
            return
        fi
        warning "No package cache. Run 'epm update' to create it."
    fi

    # get fresh data and format
    __epm_list_available_tsv | __epm_format_output | __epm_colorize_search_output
}
