load_helper epm-sh-warmup
load_helper epm-sh-search

__epm_packages_help()
{
    message "Print installed packages"
    message "Options:"
    get_help HELPOPTIONS $SHAREDIR/epm-packages
    message '
Examples:
  epm qa --short
  epm packages --sort
  epm packages --sort=size
  epm packages --last
'
}

__epm_packages_sort()
{

case $PMTYPE in
    *-rpm)
        # FIXME: space with quotes problems, use point instead
        warmup_rpmbase
        if [ -n "$short" ] ; then
            docmd rpm -qa --queryformat "%{size}@%{name}\n" "$@" | sed -e "s|@| |g" | sort -n -k1 -r
        else
            docmd rpm -qa --queryformat "%{size}@%{name}-%{version}-%{release}\n" "$@" | sed -e "s|@| |g" | sort -n -k1 -r
        fi
        ;;
    *-dpkg)
        warmup_dpkgbase
        if [ -n "$short" ] ; then
            docmd dpkg-query -W --showformat="\${Installed-Size}@\${Package}\n" "$@" | sed -e "s|@| |g" | sort -n -k1 -r
        else
            docmd dpkg-query -W --showformat="\${Installed-Size}@\${Package}-\${Version}:\${Architecture}\n" "$@" | sed -e "s|@| |g" | sort -n -k1 -r
        fi
        ;;
    *)
        fatal 'Sorted package list function is not implemented for $PMTYPE'
        ;;
esac
}

__epm_packages_last()
{
case $PMTYPE in
    *-rpm)
        # FIXME: space with quotes problems, use point instead
        warmup_rpmbase
        docmd rpm -qa --last
        ;;
    pacman)
        assure_exists expac
        docmd expac --timefmt='%Y-%m-%d %T' '%l\t%n %v' | sort | tail -200 | nl
        ;;
    *)
        fatal "Last package list function is not implemented for $PMTYPE"
        ;;
esac
}

__aptcyg_print_full()
{
    #showcmd apt-cyg show
    local VERSION=$(a= apt-cyg show "$1" | grep -m1 "^version: " | sed -e "s|^version: ||g")
    echo "$1	$VERSION	"
}

# Get installed packages in TSV format
# Returns: TSV format: package<tab>version<tab>description
__epm_packages_tsv()
{
    local CMD

    case $PMTYPE in
        *-dpkg)
            warmup_dpkgbase
            # note: use literal tabs in format string
            docmd dpkg-query -W --showformat='${db:Status-Abbrev}${Package}	${Version}	${binary:Summary}\n' | grep "^.i" | sed -e "s|^.. ||g"
            ;;
        *-rpm)
            warmup_rpmbase
            # note: use literal tabs in format string
            docmd rpm -qa --queryformat '%{name}	%{version}-%{release}	%{summary}\n'
            ;;
        snap)
            # snap list: Name Version Rev Tracking Publisher Notes
            docmd snap list 2>/dev/null | tail -n +2 | awk '{print $1"\t"$2"\t"}'
            ;;
        flatpak)
            docmd flatpak list --app --columns=application,version,name 2>/dev/null | awk -F'\t' '{print $1"\t"$2"\t"$3}'
            ;;
        pacman)
            # pacman -Q outputs: name version
            docmd pacman -Q 2>/dev/null | awk '{print $1"\t"$2"\t"}'
            ;;
        pkgng)
            docmd pkg info 2>/dev/null | awk '{
                # name-version comment
                n = split($1, a, "-")
                pkg = a[1]
                for (i=2; i<n; i++) pkg = pkg "-" a[i]
                ver = a[n]
                $1 = ""
                gsub(/^ /, "", $0)
                print pkg"\t"ver"\t"$0
            }'
            ;;
        eopkg)
            # name - description, version
            docmd eopkg list-installed 2>/dev/null | awk -F' - ' '{
                pkg = $1
                rest = $2
                n = split(rest, a, ", ")
                ver = a[n]
                desc = a[1]
                for (i=2; i<n; i++) desc = desc ", " a[i]
                print pkg"\t"ver"\t"desc
            }'
            ;;
        pisi)
            docmd pisi list-installed 2>/dev/null | awk -F' - ' '{
                pkg = $1
                rest = $2
                n = split(rest, a, ", ")
                ver = a[n]
                desc = a[1]
                for (i=2; i<n; i++) desc = desc ", " a[i]
                print pkg"\t"ver"\t"desc
            }'
            ;;
        opkg)
            # name - version - description
            docmd opkg list-installed 2>/dev/null | awk -F' - ' '{print $1"\t"$2"\t"$3}'
            ;;
        apk)
            # name-version description
            docmd apk list --installed 2>/dev/null | awk '{
                n = split($1, a, "-")
                pkg = a[1]
                for (i=2; i<n; i++) pkg = pkg "-" a[i]
                ver = a[n]
                $1 = ""
                gsub(/^ /, "", $0)
                gsub(/ \[installed\]/, "", $0)
                print pkg"\t"ver"\t"$0
            }'
            ;;
        nix)
            docmd nix-env -q --description 2>/dev/null | awk '{
                n = split($1, a, "-")
                pkg = a[1]
                for (i=2; i<n; i++) pkg = pkg "-" a[i]
                ver = a[n]
                $1 = ""
                gsub(/^ +/, "", $0)
                print pkg"\t"ver"\t"$0
            }'
            ;;
        termux-pkg)
            # name/repo version arch [status]
            docmd pkg list-installed 2>/dev/null | awk -F'/' '{
                pkg = $1
                split($2, a, " ")
                ver = a[1]
                print pkg"\t"ver"\t"
            }'
            ;;
        xbps)
            # ii name-version description
            docmd xbps-query -l 2>/dev/null | awk '{
                sub(/^ii /, "")
                n = split($1, a, "-")
                pkg = a[1]
                for (i=2; i<n; i++) pkg = pkg "-" a[i]
                ver = a[n]
                $1 = ""
                gsub(/^ +/, "", $0)
                print pkg"\t"ver"\t"$0
            }'
            ;;
        android)
            docmd pm list packages | sed -e "s|^package:||g" | awk '{print $1"\t\t"}'
            ;;
        homebrew)
            docmd brew list | xargs -n1 | awk '{print $1"\t\t"}'
            ;;
        # fallback: use CMD variable
        packagekit)
            CMD="pkcon get-packages --filter installed"
            ;;
        snappy)
            CMD="snappy info"
            ;;
        emerge)
            CMD="qlist -I -C"
            ;;
        pkgsrc)
            CMD="pkg_info"
            ;;
        npackd)
            CMD="npackdcl list --status=installed"
            ;;
        conary)
            CMD="conary query"
            ;;
        stplr)
            CMD="stplr list --installed"
            ;;
        choco)
            CMD="choco list"
            ;;
        slackpkg)
            CMD="ls -1 /var/log/packages/"
            ;;
        tce)
            CMD="ls -1 /usr/local/tce.installed"
            ;;
        guix)
            CMD="guix package -I"
            ;;
        appget)
            CMD="appget list"
            ;;
        winget)
            CMD="winget list"
            ;;
        aptcyg)
            for i in $(a= apt-cyg list) ; do
                __aptcyg_print_full $i
            done
            ;;
        *)
            fatal 'Have no suitable query command for $PMTYPE'
            ;;
    esac

    [ -n "$CMD" ] && docmd $CMD
}

epm_packages()
{
    case "$1" in
        -h|--help|help)  # HELPOPTIONS: help
            __epm_packages_help
            return
            ;;
        --sort=size|--sort)   # HELPOPTIONS: list package(s) by size, most
            __epm_packages_sort
            return
            ;;
        --last|--sort=time)   # HELPOPTIONS: list package(s) by install time, most
            __epm_packages_last
            return
            ;;
        --short)              # HELPOPTIONS: print out short package names
            # for help entry only
            ;;
        --tsv)                # HELPOPTIONS: print in TSV format (name<tab>version<tab>description)
            # for help entry only
            ;;
        "")
            ;;
        *)
            opt="$1"
            fatal 'Unknown option $opt. Use epm packages --help to get help.'
    esac

    # main output: TSV -> filter -> format -> colorize
    __epm_packages_tsv | __epm_filter_by_pattern "$@" | __epm_format_output | __epm_colorize_search_output
}
