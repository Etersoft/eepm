# Functions for working with available packages cache
# Cache format: package<tab>version<tab>description (TSV)

# Get path to cache file (per-backend, with fallback to old name)
__epm_available_cache_file()
{
    if [ -s "$epm_vardir/available-packages-$PMTYPE" ] || [ ! -s "$epm_vardir/available-packages" ] ; then
        echo "$epm_vardir/available-packages-$PMTYPE"
    else
        echo "$epm_vardir/available-packages"
    fi
}

# Check if cache file exists and is not empty
__epm_available_cache_exists()
{
    [ -s "$(__epm_available_cache_file)" ]
}

# Read raw TSV from cache
# Returns: packages in TSV format: package<tab>version<tab>description
__epm_available_read_cache()
{
    __epm_available_cache_exists || return 1
    cat "$(__epm_available_cache_file)"
}

# Save available packages to cache (called from epm update)
__epm_available_save_cache()
{
    [ -d "$epm_vardir" ] || return 0

    # TODO: ignore in docker
    # update list only if the system supports bash completion
    [ -d /etc/bash_completion.d ] || return 0

    # HACK: too much time (5 minutes) on deb systems in a docker
    # [ $PMTYPE = "apt-dpkg" ] && return 0

    info "Retrieving list of all available packages (for autocompletion) ..."
    # can ask sudo later
    set_sudo
    # get TSV format, sort and save
    __epm_list_available_tsv | sort | sudorun tee "$(__epm_available_cache_file)" >/dev/null
}
