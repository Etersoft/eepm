# epm tool epm-command-not-found - command-not-found helper
# Suggests package installation when unknown command is entered

PROGDIR="$(dirname "$0")"
SHAREDIR="$PROGDIR"
[ "$PROGDIR" = "." ] && PROGDIR="$(pwd)"

# Load config if exists
CNF_ENABLED=1
CNF_SEARCH_PLAY=1
CNF_SEARCH_REPO=1
CNF_KEYBOARD_CONVERT=1
CNF_FUZZY_SEARCH=1
CNF_MAX_SUGGESTIONS=5

if [ -f /etc/eepm/command-not-found.conf ] ; then
    . /etc/eepm/command-not-found.conf
fi

if [ -f ~/.config/eepm/command-not-found.conf ] ; then
    . ~/.config/eepm/command-not-found.conf
fi

[ "$CNF_ENABLED" = "0" ] && exit 127

# Convert Russian keyboard layout to English
# Based on standard QWERTY/ЙЦУКЕН layout mapping
convert_ru_to_en()
{
    echo "$1" | sed \
        -e 's/й/q/g' -e 's/ц/w/g' -e 's/у/e/g' -e 's/к/r/g' -e 's/е/t/g' \
        -e 's/н/y/g' -e 's/г/u/g' -e 's/ш/i/g' -e 's/щ/o/g' -e 's/з/p/g' \
        -e 's/х/[/g' -e 's/ъ/]/g' -e 's/ф/a/g' -e 's/ы/s/g' -e 's/в/d/g' \
        -e 's/а/f/g' -e 's/п/g/g' -e 's/р/h/g' -e 's/о/j/g' -e 's/л/k/g' \
        -e 's/д/l/g' -e 's/ж/;/g' -e "s/э/'/g" -e 's/я/z/g' -e 's/ч/x/g' \
        -e 's/с/c/g' -e 's/м/v/g' -e 's/и/b/g' -e 's/т/n/g' -e 's/ь/m/g' \
        -e 's/б/,/g' -e 's/ю/./g' \
        -e 's/Й/Q/g' -e 's/Ц/W/g' -e 's/У/E/g' -e 's/К/R/g' -e 's/Е/T/g' \
        -e 's/Н/Y/g' -e 's/Г/U/g' -e 's/Ш/I/g' -e 's/Щ/O/g' -e 's/З/P/g' \
        -e 's/Х/{/g' -e 's/Ъ/}/g' -e 's/Ф/A/g' -e 's/Ы/S/g' -e 's/В/D/g' \
        -e 's/А/F/g' -e 's/П/G/g' -e 's/Р/H/g' -e 's/О/J/g' -e 's/Л/K/g' \
        -e 's/Д/L/g' -e 's/Ж/:/g' -e 's/Э/"/g' -e 's/Я/Z/g' -e 's/Ч/X/g' \
        -e 's/С/C/g' -e 's/М/V/g' -e 's/И/B/g' -e 's/Т/N/g' -e 's/Ь/M/g' \
        -e 's/Б/</g' -e 's/Ю/>/g'
}

# Check if string contains Cyrillic characters
has_cyrillic()
{
    echo "$1" | grep -q '[а-яА-ЯёЁ]'
}

# Search for command in epm play applications (exact match)
search_play()
{
    local cmd="$1"
    "$SHAREDIR/epm" play --list-all --quiet --short 2>/dev/null | grep -x "$cmd" | head -1
}

# Fuzzy search for command in epm play applications
search_play_fuzzy()
{
    [ "$CNF_FUZZY_SEARCH" = "1" ] || return
    local cmd="$1"
    "$SHAREDIR/epm" --fuzzy=$CNF_MAX_SUGGESTIONS play --short --search "$cmd" 2>/dev/null
}

# Search for package providing command via epm sf
search_package()
{
    local cmd="$1"
    # Search for /usr/bin/cmd or /bin/cmd
    local pkg
    pkg=$("$SHAREDIR/epm" sf "/usr/bin/$cmd" 2>/dev/null | head -1)
    [ -z "$pkg" ] && pkg=$("$SHAREDIR/epm" sf "/bin/$cmd" 2>/dev/null | head -1)
    echo "$pkg"
}

show_help()
{
    cat <<'EOF'
epm tool epm-command-not-found - command-not-found helper

Usage: epm tool epm-command-not-found <command>

When an unknown command is entered, this tool suggests:
  1. epm play applications matching the command name
  2. Repository packages providing the command

Configuration: /etc/eepm/command-not-found.conf or ~/.config/eepm/command-not-found.conf
  CNF_ENABLED=1           enable/disable (default: 1)
  CNF_SEARCH_PLAY=1       search in epm play (default: 1)
  CNF_SEARCH_REPO=1       search in repository (default: 1)
  CNF_KEYBOARD_CONVERT=1  convert Russian keyboard layout (default: 1)
  CNF_FUZZY_SEARCH=1      enable fuzzy search (default: 1)
  CNF_MAX_SUGGESTIONS=5   max fuzzy suggestions (default: 5)
EOF
}

# Main logic
main()
{
    local cmd="$1"

    [ -z "$cmd" ] && show_help && exit 0
    [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] || [ "$cmd" = "help" ] && show_help && exit 0

    local found=0
    local converted_cmd=""

    # Try keyboard layout conversion for Cyrillic input
    if [ "$CNF_KEYBOARD_CONVERT" = "1" ] && has_cyrillic "$cmd" ; then
        converted_cmd=$(convert_ru_to_en "$cmd")
        if command -v "$converted_cmd" >/dev/null 2>&1 ; then
            echo ""
            echo "Возможно, вы имели в виду: $converted_cmd"
            echo ""
            found=1
        fi
    fi

    # Search in epm play
    if [ "$CNF_SEARCH_PLAY" = "1" ] ; then
        local play_match
        local search_target="$cmd"
        [ -n "$converted_cmd" ] && search_target="$converted_cmd"

        play_match=$(search_play "$search_target")
        if [ -n "$play_match" ] ; then
            echo ""
            echo "Приложение '$search_target' доступно через epm play:"
            echo "  epm play $search_target"
            echo ""
            found=1
        else
            # Try fuzzy search if no exact match
            local fuzzy_matches
            fuzzy_matches=$(search_play_fuzzy "$search_target")
            if [ -n "$fuzzy_matches" ] ; then
                echo ""
                echo "Похожие приложения доступны через epm play:"
                echo "$fuzzy_matches" | while read -r app ; do
                    echo "  epm play $app"
                done
                echo ""
                found=1
            fi
        fi
    fi

    # Search in repository
    if [ "$CNF_SEARCH_REPO" = "1" ] ; then
        local search_cmd="$cmd"
        [ -n "$converted_cmd" ] && search_cmd="$converted_cmd"

        local pkg
        pkg=$(search_package "$search_cmd")
        if [ -n "$pkg" ] ; then
            echo ""
            echo "Программа '$search_cmd' может быть установлена:"
            echo "  epm install $pkg"
            echo ""
            found=1
        fi
    fi

    [ "$found" = "0" ] && return 1
    return 0
}

main "$@"
exit 127
