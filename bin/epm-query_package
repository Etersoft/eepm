load_helper epm-packages
load_helper epm-search

__epm_query_package()
{
    (pkg_filenames="$*" quoted_args="$*" quiet=1 epm_query_package)
}

epm_query_package()
{
    [ -n "$quoted_args" ] || fatal "Please, use search with some argument or run epmqa for get all packages."
    local MGS
    MGS=$(eval __epm_search_make_grep $quoted_args)
    EXTRA_SHOWDOCMD=$MGS

    # get pattern for colorizing
    __epm_color_pattern=$(eval __epm_get_color_pattern $quoted_args)

    # Note: get all packages list and do grep
    eval "epm_packages $MGS" | __epm_colorize_search_output
}
