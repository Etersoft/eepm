load_helper epm-check_updated_repo
load_helper epm-sh-warmup
load_helper epm-sh-backend
load_helper epm-sh-search
load_helper epm-list_available

__epm_search_output()
{
local CMD
local string="$*"

# Try cache first for supported package managers
case $PMTYPE in
    apt-rpm|apt-dpkg|dnf-rpm|dnf5-rpm|yum-rpm|zypper-rpm|pacman)
        if __epm_search_from_cache ; then
            return
        fi
        ;;
esac

# Fallback to native search commands
case $PMTYPE in
    apt-rpm|apt-dpkg)
        CMD="apt-cache search --"
        ;;
    apm-rpm)
        docmd apm system search -- $string
        return
        ;;
    aptitude-dpkg)
        CMD="aptitude search --"
        ;;
    deepsolver-rpm)
        CMD="ds-require --"
        ;;
    packagekit)
        CMD="pkcon search name"
        ;;
    urpm-rpm)
        # urpmq does not support --
        CMD="urpmq -y"
        ;;
    pkgsrc)
        CMD="pkg_info -x --"
        ;;
    pkgng)
        CMD="pkg search -i --"
        ;;
    emerge)
        CMD="emerge --search --"
        ;;
    pacman)
        CMD="pacman -Ss --"
        ;;
    aura)
        CMD="aura -As --"
        ;;
    eopkg)
        CMD="eopkg search --"
        ;;
    stplr)
        CMD="stplr search --"
        ;;
    pisi)
        CMD="pisi search --"
        ;;
    yum-rpm)
        CMD="yum search"
        ;;
    dnf-rpm|dnf5-rpm)
        CMD="dnf search"
        ;;
    zypper-rpm)
        CMD="zypper search -d --"
        ;;
    mpkg)
        CMD="mpkg search"
        ;;
    apk)
        CMD="apk search"
        ;;
    tce)
        CMD="tce-ab"
        ;;
    conary)
        CMD="conary repquery"
        ;;
    npackd)
        docmd npackdcl search --query="$string" --status=all
        return
        ;;
    choco)
        CMD="choco list"
        ;;
    slackpkg)
        # FIXME
        echo "Note: case sensitive search"
        if [ -n "$verbose" ] ; then
            CMD="/usr/sbin/slackpkg search"
        else
            LC_ALL=C docmd /usr/sbin/slackpkg search $string | grep " - " | sed -e 's|.* - ||g'
            return
        fi
        ;;
    opkg)
        CMD="opkg find"
        ;;
    homebrew)
        CMD="brew search"
        ;;
    guix)
        CMD="guix package -A"
        ;;
    android)
        CMD="pm list packages"
        ;;
    termux-pkg)
        CMD="pkg search"
        ;;
    aptcyg)
        CMD="apt-cyg searchall"
        ;;
    xbps)
        CMD="xbps-query -s"
        ;;
    appget|winget)
        CMD="$PMTYPE search"
        ;;
    *)
        fatal "Have no suitable search command for $PMTYPE"
        ;;
esac

LC_ALL=C docmd $CMD $string

}


# ^mc.*ext -> mc
_clean_from_regexp()
{
    sed -e "s/[?\^.*]/ /g"
}

# ^mc*e?t -> mc
__clean_from_glob()
{
    sed -e "s/[?*].*//" -e "s/[?\^.*]/ /g"
}

# Expand wildcard package pattern to matching packages from repositories
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching packages (with descriptions, or names only if $short is set)
__epm_expand_wildcard_pattern()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")( |\$)"

    if [ -n "$short" ] ; then
        showcmd "epm search --short '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | sed -e "s| .*||g" | grep -E "^$(__convert_glob__to_regexp "$pattern")$"
    else
        showcmd "epm search '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | grep -E "$regexp"
    fi
}

# Expand all wildcard patterns in package list
# Args: package names (may include wildcards)
# Returns: expanded package names (wildcards replaced with matching packages)
__epm_expand_wildcards()
{
    local result=""
    local pkg

    for pkg in "$@" ; do
        if is_wildcard "$pkg" ; then
            # Get short names for filtering
            local matched
            matched="$(short=1 __epm_expand_wildcard_pattern "$pkg")"

            if [ -z "$matched" ] ; then
                warning "No packages found matching pattern '$pkg'"
                continue
            fi

            # Filter out installed packages before showing interactive menu
            if [ -n "$skip_installed" ] ; then
                load_helper epm-sh-install
                matched="$(echo "$matched" | filter_out_installed_packages)"
                if [ -z "$matched" ] ; then
                    info "All packages matching '$pkg' are already installed"
                    continue
                fi
            fi

            local match_count
            match_count="$(echo "$matched" | wc -l)"

            if [ -n "$suggest_interactive$interactive" ] && [ -c /dev/tty ] ; then
                # Interactive mode: let user select from matches (via config or --interactive flag)
                # Get packages with descriptions for better selection
                local matched_verbose
                matched_verbose="$(short='' __epm_expand_wildcard_pattern "$pkg")"
                # Filter installed if needed (by name)
                if [ -n "$skip_installed" ] ; then
                    local names_only
                    names_only="$(echo "$matched" | tr '\n' ' ')"
                    matched_verbose="$(echo "$matched_verbose" | while read -r line ; do
                        local name="${line%% *}"
                        echo " $names_only " | grep -q " $name " && echo "$line"
                    done)"
                fi
                load_helper epm-sh-interactive
                local selected
                selected="$(echo "$matched_verbose" | __epm_interactive_select_packages install)"
                if [ -n "$selected" ] ; then
                    # Extract only package names from selection
                    result="$result $(echo "$selected" | sed -e 's| .*||g' | tr '\n' ' ')"
                fi
            else
                # Non-interactive: install all matches
                info "Pattern '$pkg' matched $match_count package(s)"
                result="$result $(echo "$matched" | sed -e 's| .*||g' | tr '\n' ' ')"
            fi
        else
            result="$result $pkg"
        fi
    done

    echo "$result" | sed 's/^ //'
}

# Expand wildcard package pattern to matching INSTALLED packages
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching installed package names (one per line)
__epm_expand_wildcard_pattern_installed()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")$"

    load_helper epm-packages
    showcmd "epm packages --short | grep -E '$regexp'"
    short=--short epm_packages 2>/dev/null | grep -E "$regexp"
}

# Expand all wildcard patterns in package list (for INSTALLED packages)
# Args: package names (may include wildcards)
# Returns: expanded package names (wildcards replaced with matching installed packages)
__epm_expand_wildcards_installed()
{
    local result=""
    local pkg

    for pkg in "$@" ; do
        if is_wildcard "$pkg" ; then
            local matched
            matched="$(__epm_expand_wildcard_pattern_installed "$pkg")"

            if [ -z "$matched" ] ; then
                warning "No installed packages found matching pattern '$pkg'"
                continue
            fi

            local match_count
            match_count="$(echo "$matched" | wc -l)"

            if [ -n "$suggest_interactive$interactive" ] && [ -c /dev/tty ] ; then
                # Interactive mode: let user select from matches (via config or --interactive flag)
                load_helper epm-sh-interactive
                local selected
                selected="$(echo "$matched" | __epm_interactive_select_packages remove)"
                if [ -n "$selected" ] ; then
                    result="$result $(echo "$selected" | tr '\n' ' ')"
                fi
            else
                # Non-interactive: remove all matches
                info "Pattern '$pkg' matched $match_count installed package(s)"
                result="$result $(echo "$matched" | tr '\n' ' ')"
            fi
        else
            result="$result $pkg"
        fi
    done

    echo "$result" | sed 's/^ //'
}

# internal search implementation (without epm play)
__epm_search_internal()
{
    # warn about regex-like patterns when not using --regexp
    [ -z "$regexp" ] && echo "$*" | grep -q "\.[*?]" && warning "Only glob symbols * ? [] are supported. Use --regexp for regular expressions."

    local MGS
    MGS=$(__epm_search_make_grep "$@")
    EXTRA_SHOWDOCMD="$MGS"

    # use longest word for PM search (more precise results)
    local search_word
    search_word=$(__epm_get_longest_word "$@")
    [ -z "$search_word" ] && search_word=$(echo "$1" | __clean_from_glob)

    # get pattern for colorizing
    __epm_color_pattern=$(__epm_get_color_pattern "$@")

    # run search with colorization
    eval "__epm_search_output \"\$search_word\" $MGS" | __epm_colorize_search_output
}

epm_search()
{
    [ -n "$1" ] || fatal "Search: search argument(s) is missed"

    # check backend:package syntax (snap:pkg, nix:pkg)
    if __has_backend_syntax "$@" ; then
        __process_backend_arguments __epm_search_internal "$@"
        return
    fi

    # it is useful for first time running
    update_repo_if_needed soft

    warmup_bases

    # run main search
    eval "__epm_search_internal $quoted_args"

    # search in epm play separately
    if [ -z "$no_epm_play_search" ] ; then
        local hint="(use 'epm play' to install it)"
        if [ -n "$USETTY" ] ; then
            hint="$(printf '\033[32m')$hint$(printf '\033[0m')"
        fi
        eval "epm play --search $quoted_args" | sed -e "s/  */ /g" -e "s/\$/ $hint/"
    fi
}
