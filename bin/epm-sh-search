# Common search functions for epm search and epm play --search

# Get the longest word from arguments (for searching via package manager)
# PM search works better with longer words
__epm_get_longest_word()
{
    local longest=""
    local arg
    local word
    for arg in "$@" ; do
        # skip exclusion patterns
        case "$arg" in
            ~*) continue ;;
        esac
        # clean pattern chars (replace with space to split OR patterns like (a|b))
        # then find longest word among all
        for word in $(echo "$arg" | sed -e 's/[][?*()|\^]/ /g') ; do
            [ -z "$word" ] && continue
            if [ ${#word} -gt ${#longest} ] ; then
                longest="$word"
            fi
        done
    done
    echo "$longest"
}

# Convert glob pattern to regexp
# Supports: * ? ^ $ (|) [abc] [!abc] \[ \]
__epm_glob_to_regexp()
{
    local pattern="$1"
    # escape: . { } +
    # keep \ ^ $ ( ) | [ ] for extended patterns and escaping
    echo "$pattern" | sed \
        -e 's|[.{}+]|\\&|g' \
        -e 's|\*|.*|g' \
        -e 's|?|.|g'
}

# Produce grep filter sequence for multiple search patterns
# Args: patterns (use ~pattern for exclusion)
# Uses: $short, $regexp, $fuzzy, $PMTYPE
__epm_search_make_grep()
{
    local i
    [ -z "$*" ] && return

    local list=
    local listN=
    for i in "$@" ; do
        case "$i" in
            ~*)
                # will clean from ~ later
                listN="$listN $i"
                ;;
            *)
                list="$list $i"
                ;;
        esac
    done

    listN=$(strip_spaces $listN | sed -e "s/ /|/g" | sed -e "s/~//g")

    # Fuzzy search mode - use fzf --filter instead of grep
    if [ -n "$fuzzy" ] ; then
        local fzf_pattern
        fzf_pattern=$(strip_spaces $list)

        if [ -n "$short" ] ; then
            echon " | sed -e \"s| .*||g\""
        fi

        [ -n "$listN" ] && echon " | grep -E -i -v -- \"$listN\""

        if is_command fzf ; then
            echon " | fzf --filter=\"$fzf_pattern\" 2>/dev/null | head -$fuzzy"
        else
            warning "fzf is not installed for fuzzy search. Install: epm install fzf"
            # fallback to grep
            echon " | grep -i -- \"$fzf_pattern\" | head -$fuzzy"
        fi
        return
    fi

    # convert glob to regexp (skip if --regexp mode - user provides regexp directly)
    if [ -z "$regexp" ] ; then
        case $PMTYPE in
            apt-*)
                ;;
            *)
                list=$(echo "$list" | sed -e "s/[?\^.\$]/ /g")
                listN=$(echo "$listN" | sed -e "s/[?\^.\$]/ /g")
                ;;
        esac
        list=$(__epm_glob_to_regexp "$list")
        listN=$(__epm_glob_to_regexp "$listN")
    fi

    if [ -n "$short" ] ; then
        echon " | sed -e \"s| .*||g\""
    fi

    [ -n "$listN" ] && echon " | grep -E -i -v -- \"$listN\""

    # filter by all words (AND logic)
    for i in $list ; do
        echon " | grep -E -i -- \"$i\""
    done
}

# Get color pattern for search highlighting
# Args: patterns (use ~pattern for exclusion)
# Returns: pattern string joined with | for grep/awk colorization
__epm_get_color_pattern()
{
    local i
    [ -z "$*" ] && return

    local list=""
    for i in "$@" ; do
        case "$i" in
            ~*) ;;  # skip exclusions
            *) list="$list $i" ;;
        esac
    done

    list=$(echo "$list" | sed 's/^ *//')
    [ -z "$list" ] && return

    # convert glob to regexp if needed
    if [ -z "$regexp" ] ; then
        list=$(__epm_glob_to_regexp "$list")
    fi

    # join with |
    echo "$list" | sed 's/ /|/g'
}

# Colorize search output: package names and search pattern
# Input format: "[spaces]package-name - description" or "package-name"
# Uses: __epm_color_pattern - regex pattern to highlight
# Package names: CYAN, search pattern: RED (bold)
__epm_colorize_search_output()
{
    # No colors in TSV mode or when not a terminal
    if [ -n "$tsv" ] || { [ -z "$force_color" ] && ! isatty ; } ; then
        cat
        return
    fi

    local pattern="${__epm_color_pattern:-}"

    # Double backslashes for awk (awk -v interprets escape sequences)
    pattern="${pattern//\\/\\\\}"

    # Use awk for reliable ANSI color handling
    # Package names: bold cyan, search pattern: bold red
    awk -v cyan="$(printf '\033[1;36m')" \
        -v red="$(printf '\033[1;31m')" -v reset="$(printf '\033[0m')" \
        -v pattern="$pattern" '
    {
        line = $0

        if (match(line, /^ *[^ ]+ +- /)) {
            # format: "[spaces]package - description" (may have leading/padding spaces)
            # extract leading spaces
            match(line, /^ */)
            prefix = substr(line, 1, RLENGTH)
            line = substr(line, RLENGTH + 1)

            sep = index(line, " - ")
            pkg = substr(line, 1, sep - 1)
            gsub(/ +$/, "", pkg)  # trim trailing spaces from package name
            rest = substr(line, sep)

            # colorize pattern in package name (return to cyan after red)
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" cyan, pkg)
            }

            # colorize pattern in description (return to reset after red)
            if (pattern != "") {
                gsub("(" pattern ")", red "&" reset, rest)
            }

            print prefix cyan pkg reset rest
        } else if (match(line, /^[^ ]+$/)) {
            # format: "package" only
            pkg = line
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" cyan, pkg)
            }
            print cyan pkg reset
        } else if (match(line, /^[^:]+: /)) {
            # format: "package: /path/to/file" (epm sf output)
            sep = index(line, ": ")
            pkg = substr(line, 1, sep - 1)
            rest = substr(line, sep)

            # colorize pattern in package name (return to cyan after red)
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" cyan, pkg)
            }

            # colorize pattern in file path (return to reset after red)
            if (pattern != "") {
                gsub("(" pattern ")", red "&" reset, rest)
            }

            print cyan pkg reset rest
        } else {
            # other format - just colorize pattern
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" reset, line)
            }
            print line
        }
    }'
}

# Expand wildcard package pattern to matching packages from repositories
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching packages (with descriptions, or names only if $short is set)
__epm_expand_wildcard_pattern()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")( |\$)"

    if [ -n "$short" ] ; then
        showcmd "epm search --short '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | sed -e "s| .*||g" | grep -E "^$(__convert_glob__to_regexp "$pattern")$"
    else
        showcmd "epm search '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | grep -E "$regexp"
    fi
}

# Expand all wildcard patterns in package list
# Args: action (install|remove), package names (may include wildcards)
# Returns: expanded package names (wildcards replaced with matching packages)
# Exit codes: 0 = success, 1 = error, 10 = interactive selection was used
__epm_expand_wildcards_impl()
{
    local action="$1"
    shift
    local result=""
    local pkg
    local had_interactive_selection=""

    # Build function name suffix for installed packages
    local func_suffix=""
    [ "$action" = "remove" ] && func_suffix="_installed"

    for pkg in "$@" ; do
        if is_wildcard "$pkg" ; then
            # Get packages with descriptions (single search)
            local matched_verbose
            matched_verbose="$(short='' __epm_expand_wildcard_pattern$func_suffix "$pkg")"

            if [ -z "$matched_verbose" ] ; then
                warning "No${func_suffix:+ installed} packages found matching pattern '$pkg'"
                continue
            fi

            # Extract short names from full results
            local matched
            matched="$(echo "$matched_verbose" | sed -e 's| .*||g')"

            # Filter out installed packages before showing interactive menu (only for install)
            if [ "$action" = "install" ] && [ -n "$skip_installed" ] ; then
                load_helper epm-sh-install
                matched="$(echo "$matched" | filter_out_installed_packages)"
                if [ -z "$matched" ] ; then
                    info "All packages matching '$pkg' are already installed"
                    continue
                fi
            fi

            local match_count
            match_count="$(echo "$matched" | wc -l)"

            if [ -n "$suggest_interactive$interactive" ] && [ -c /dev/tty ] ; then
                # Interactive mode: let user select from matches (via config or --interactive flag)
                # Filter installed if needed (by name) - only for install
                if [ "$action" = "install" ] && [ -n "$skip_installed" ] ; then
                    local names_only
                    names_only="$(echo "$matched" | tr '\n' ' ')"
                    matched_verbose="$(echo "$matched_verbose" | while read -r line ; do
                        local name="${line%% *}"
                        echo " $names_only " | grep -q " $name " && echo "$line"
                    done)"
                fi
                load_helper epm-sh-interactive
                local selected
                selected="$(echo "$matched_verbose" | __epm_interactive_select_packages "$action")"
                if [ -n "$selected" ] ; then
                    had_interactive_selection=1
                    # Extract only package names from selection (strip =version and description)
                    result="$result $(echo "$selected" | sed -e 's|[= ].*||' | tr '\n' ' ')"
                fi
            else
                # Non-interactive: process all matches
                info "Pattern '$pkg' matched $match_count${func_suffix:+ installed} package(s)"
                result="$result $(echo "$matched" | sed -e 's|[= ].*||' | tr '\n' ' ')"
            fi
        else
            result="$result $pkg"
        fi
    done

    echo "$result" | sed 's/^ //'
    [ -n "$had_interactive_selection" ] && return 10
    return 0
}

__epm_expand_wildcards()
{
    __epm_expand_wildcards_impl install "$@"
}

# Expand wildcard package pattern to matching INSTALLED packages (with version and description)
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching installed packages in format: package=version - description
__epm_expand_wildcard_pattern_installed()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")="

    load_helper epm-packages
    showcmd "epm packages | grep -E '$regexp'"
    epm_packages 2>/dev/null | grep -E "$regexp"
}

__epm_expand_wildcards_installed()
{
    __epm_expand_wildcards_impl remove "$@"
}
