# Common search functions for epm search and epm play --search

# Get the longest word from arguments (for searching via package manager)
# PM search works better with longer words
__epm_get_longest_word()
{
    local longest=""
    local word
    for word in "$@" ; do
        # skip exclusion patterns
        case "$word" in
            ~*) continue ;;
        esac
        # clean glob characters for PM search
        word=$(echo "$word" | sed -e "s/[?*\[\]]//g")
        [ -z "$word" ] && continue
        if [ ${#word} -gt ${#longest} ] ; then
            longest="$word"
        fi
    done
    echo "$longest"
}

# Convert glob pattern to regexp
# Supports: * ? ^ $ (|) [abc] [!abc] \[ \]
__epm_glob_to_regexp()
{
    local pattern="$1"
    # escape: . { } +
    # keep \ ^ $ ( ) | [ ] for extended patterns and escaping
    echo "$pattern" | sed \
        -e 's|[.{}+]|\\&|g' \
        -e 's|\*|.*|g' \
        -e 's|?|.|g' \
        -e 's|\[!|\[^|g'
}

# Build grep filter pipeline for search results
# Args: patterns (use ~pattern for exclusion)
# Uses: $short, $regexp, $EGREPCOLOR
__epm_build_grep_filter()
{
    local i
    [ -z "$*" ] && return

    local list=""
    local listN=""

    # separate include and exclude patterns
    for i in "$@" ; do
        case "$i" in
            ~*)
                listN="$listN ${i#\~}"
                ;;
            *)
                list="$list $i"
                ;;
        esac
    done

    list=$(echo "$list" | sed 's/^ *//' | sed 's/ *$//')
    listN=$(echo "$listN" | sed 's/^ *//' | sed 's/ *$//' | sed 's/ /|/g')

    # convert to regexp (unless --regexp mode)
    if [ -z "$regexp" ] ; then
        list=$(__epm_glob_to_regexp "$list")
        listN=$(__epm_glob_to_regexp "$listN")
    fi

    # short mode: strip description
    if [ -n "$short" ] ; then
        echon " | sed -e 's| .*||g'"
    fi

    # exclusion filter
    [ -n "$listN" ] && echon " | grep -E -i -v -- \"$listN\""

    # inclusion filters (one per word if multiple)
    local word_count
    word_count=$(echo "$list" | wc -w)
    if [ "$word_count" -gt 1 ] ; then
        for i in $list ; do
            echon " | grep -E -i -- \"$i\""
        done
    fi

    # colorize matches
    local COLO=""
    for i in $list $listN ; do
        [ -n "$COLO" ] && COLO="$COLO|"
        COLO="$COLO$i"
    done

    if [ -n "$list" ] ; then
        echon " | grep -E -i $EGREPCOLOR -- \"($COLO)\""
    fi
}

# Produce grep filter sequence for multiple search patterns
# Args: patterns (use ~pattern for exclusion)
# Uses: $short, $regexp, $PMTYPE
__epm_search_make_grep()
{
    local i
    [ -z "$*" ] && return

    local list=
    local listN=
    for i in $@ ; do
        case "$i" in
            ~*)
                # will clean from ~ later
                listN="$listN $i"
                ;;
            *)
                list="$list $i"
                ;;
        esac
    done

    listN=$(strip_spaces $listN | sed -e "s/ /|/g" | sed -e "s/~//g")

    # convert glob to regexp (skip if --regexp mode - user provides regexp directly)
    if [ -z "$regexp" ] ; then
        case $PMTYPE in
            apt-*)
                ;;
            *)
                list=$(echo "$list" | sed -e "s/[?\^.]/ /g")
                listN=$(echo "$listN" | sed -e "s/[?\^.]/ /g")
                ;;
        esac
        list=$(__convert_glob__to_regexp "$list")
        listN=$(__convert_glob__to_regexp "$listN")
    fi

    if [ -n "$short" ] ; then
        echon " | sed -e \"s| .*||g\""
    fi

    [ -n "$listN" ] && echon " | grep -E -i -v -- \"$listN\""

    # filter by all words (AND logic)
    for i in $list ; do
        echon " | grep -E -i -- \"$i\""
    done
}

# Get color pattern for search highlighting
# Args: patterns (use ~pattern for exclusion)
# Returns: pattern string joined with | for grep/awk colorization
__epm_get_color_pattern()
{
    local i
    [ -z "$*" ] && return

    local list=""
    for i in "$@" ; do
        case "$i" in
            ~*) ;;  # skip exclusions
            *) list="$list $i" ;;
        esac
    done

    list=$(echo "$list" | sed 's/^ *//')
    [ -z "$list" ] && return

    # convert glob to regexp if needed
    if [ -z "$regexp" ] ; then
        list=$(__convert_glob__to_regexp "$list")
    fi

    # join with |
    echo "$list" | sed 's/ /|/g'
}

# Colorize search output: package names and search pattern
# Input format: "package-name - description" or "package-name"
# Uses: __epm_color_pattern - regex pattern to highlight
# Package names: CYAN, search pattern: RED (bold)
__epm_colorize_search_output()
{
    if [ -z "$force_color" ] && ! isatty ; then
        cat
        return
    fi

    local pattern="${__epm_color_pattern:-}"

    # Use awk for reliable ANSI color handling
    awk -v cyan="$(printf '\033[36m')" \
        -v red="$(printf '\033[1;31m')" -v reset="$(printf '\033[0m')" \
        -v pattern="$pattern" '
    {
        line = $0

        if (match(line, /^[^ ]+ +- /)) {
            # format: "package - description" (may have padding spaces)
            sep = index(line, " - ")
            pkg = substr(line, 1, sep - 1)
            gsub(/ +$/, "", pkg)  # trim trailing spaces from package name
            rest = substr(line, sep)

            # colorize pattern in package name (return to cyan after red)
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" cyan, pkg)
            }

            # colorize pattern in description (return to reset after red)
            if (pattern != "") {
                gsub("(" pattern ")", red "&" reset, rest)
            }

            print cyan pkg reset rest
        } else if (match(line, /^[^ ]+$/)) {
            # format: "package" only
            pkg = line
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" cyan, pkg)
            }
            print cyan pkg reset
        } else {
            # other format - just colorize pattern
            if (pattern != "") {
                IGNORECASE = 1
                gsub("(" pattern ")", red "&" reset, line)
            }
            print line
        }
    }'
}

# Expand wildcard package pattern to matching packages from repositories
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching packages (with descriptions, or names only if $short is set)
__epm_expand_wildcard_pattern()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")( |\$)"

    if [ -n "$short" ] ; then
        showcmd "epm search --short '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | sed -e "s| .*||g" | grep -E "^$(__convert_glob__to_regexp "$pattern")$"
    else
        showcmd "epm search '$pattern'"
        no_epm_play_search=1 __epm_search_internal "$pattern" 2>/dev/null | grep -E "$regexp"
    fi
}

# Expand all wildcard patterns in package list
# Args: package names (may include wildcards)
# Returns: expanded package names (wildcards replaced with matching packages)
__epm_expand_wildcards()
{
    local result=""
    local pkg

    for pkg in "$@" ; do
        if is_wildcard "$pkg" ; then
            # Get short names for filtering
            local matched
            matched="$(short=1 __epm_expand_wildcard_pattern "$pkg")"

            if [ -z "$matched" ] ; then
                warning "No packages found matching pattern '$pkg'"
                continue
            fi

            # Filter out installed packages before showing interactive menu
            if [ -n "$skip_installed" ] ; then
                load_helper epm-sh-install
                matched="$(echo "$matched" | filter_out_installed_packages)"
                if [ -z "$matched" ] ; then
                    info "All packages matching '$pkg' are already installed"
                    continue
                fi
            fi

            local match_count
            match_count="$(echo "$matched" | wc -l)"

            if [ -n "$suggest_interactive$interactive" ] && [ -c /dev/tty ] ; then
                # Interactive mode: let user select from matches (via config or --interactive flag)
                # Get packages with descriptions for better selection
                local matched_verbose
                matched_verbose="$(short='' __epm_expand_wildcard_pattern "$pkg")"
                # Filter installed if needed (by name)
                if [ -n "$skip_installed" ] ; then
                    local names_only
                    names_only="$(echo "$matched" | tr '\n' ' ')"
                    matched_verbose="$(echo "$matched_verbose" | while read -r line ; do
                        local name="${line%% *}"
                        echo " $names_only " | grep -q " $name " && echo "$line"
                    done)"
                fi
                load_helper epm-sh-interactive
                local selected
                selected="$(echo "$matched_verbose" | __epm_interactive_select_packages install)"
                if [ -n "$selected" ] ; then
                    # Extract only package names from selection
                    result="$result $(echo "$selected" | sed -e 's| .*||g' | tr '\n' ' ')"
                fi
            else
                # Non-interactive: install all matches
                info "Pattern '$pkg' matched $match_count package(s)"
                result="$result $(echo "$matched" | sed -e 's| .*||g' | tr '\n' ' ')"
            fi
        else
            result="$result $pkg"
        fi
    done

    echo "$result" | sed 's/^ //'
}

# Expand wildcard package pattern to matching INSTALLED packages
# Args: package_pattern (e.g., "lib*-devel")
# Returns: list of matching installed package names (one per line)
__epm_expand_wildcard_pattern_installed()
{
    local pattern="$1"
    local regexp
    regexp="^$(__convert_glob__to_regexp "$pattern")$"

    load_helper epm-packages
    showcmd "epm packages --short | grep -E '$regexp'"
    short=--short epm_packages 2>/dev/null | grep -E "$regexp"
}

# Expand all wildcard patterns in package list (for INSTALLED packages)
# Args: package names (may include wildcards)
# Returns: expanded package names (wildcards replaced with matching installed packages)
__epm_expand_wildcards_installed()
{
    local result=""
    local pkg

    for pkg in "$@" ; do
        if is_wildcard "$pkg" ; then
            local matched
            matched="$(__epm_expand_wildcard_pattern_installed "$pkg")"

            if [ -z "$matched" ] ; then
                warning "No installed packages found matching pattern '$pkg'"
                continue
            fi

            local match_count
            match_count="$(echo "$matched" | wc -l)"

            if [ -n "$suggest_interactive$interactive" ] && [ -c /dev/tty ] ; then
                # Interactive mode: let user select from matches (via config or --interactive flag)
                load_helper epm-sh-interactive
                local selected
                selected="$(echo "$matched" | __epm_interactive_select_packages remove)"
                if [ -n "$selected" ] ; then
                    result="$result $(echo "$selected" | tr '\n' ' ')"
                fi
            else
                # Non-interactive: remove all matches
                info "Pattern '$pkg' matched $match_count installed package(s)"
                result="$result $(echo "$matched" | tr '\n' ' ')"
            fi
        else
            result="$result $pkg"
        fi
    done

    echo "$result" | sed 's/^ //'
}
