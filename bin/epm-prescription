load_helper epm-play-common

epm_prescription_help()
{
    message 'Usage: epm prescription [options] [receipt]'
    echo ''
    echog 'Options:'
    get_help HELPOPT $SHAREDIR/epm-prescription
    echo ''
    echog 'Commands:'
    get_help HELPCMD $SHAREDIR/epm-prescription
}

epm_prescription()
{

local psdir="$(realpath $CONFIGDIR/prescription.d)"

if [ "$1" = "--list-all" ] || [ -z "$*" ] ; then
    [ -n "$short" ] || [ -n "$quiet" ] || message "Run with a name of a prescription to run:"
    __epm_play_list $psdir
    exit
fi

while [ -n "$1" ] ; do
case "$1" in
    -h|--help)            # HELPOPT: show this help
        epm_prescription_help
        exit
        ;;
    --list-all)           # HELPOPT: list all available prescriptions
        ;;
    --remove)             # HELPOPT: remove installed prescription
        shift
        if [ -z "$1" ] ; then
            fatal "run --remove with receipt name"
        fi

        __epm_play_remove "$@"
        exit
        ;;
    receipt)              # HELPCMD: run the prescription
        ;;
    -*)
        opt="$1"
        fatal 'Unknown option $opt'
        ;;
     *)
        break
        ;;
esac
done

prescription="$1"
shift

has_play_script "$prescription" || fatal 'We have no idea how to play $prescription (checked in $psdir)'
__epm_play_run "$prescription" --run "$@" || fatal "There was some error during run the script."

}
